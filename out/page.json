 "notes": [
  {
   "src": "abudraham",
   "anchor_w": [
    0,
    5
   ],
   "lemma": "ברוך אתה ה' אלקינו מלך העולם",
   "text": "ברוך אתה ה' אלקינו מלך העולם יוצר אור ובורא חושך עושה שלום ובורא את הכל, פסוק הוא. ובמקום ובורא את הכל כתוב ובורא רע.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    15,
    19
   ],
   "lemma": "המאיר לארץ ולדרים עליה ברחמים",
   "text": "המאיר לארץ ולדרים עליה ברחמים על שם ועל מי לא יקום אורהו. ואם תאמר ומה מועלת האורה לארץ דבשלמא לדרים עליה יש תועלת גדולה שיוצאים לעסקיהם. ואמר ברחמים כי הוא מביא לנו האורה בדרך רחמנות מעט מעט לא בפעם אחת כלה.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    20,
    25
   ],
   "lemma": "וטובו מחדש בכל יום תמיד מעשה",
   "text": "וטובו מחדש בכל יום תמיד מעשה בראשית ר\"ל על זריחת האור בכל יום שנאמר בו כי טוב.",
   "quality": 0.98
  },
  {
   "src": "abudraham",
   "anchor_w": [
    23,
    24
   ],
   "lemma": "ואמר תמיד",
   "text": "ואמר תמיד על שם ויום ולילה לא ישבותו.",
   "quality": 0.83
  },
  {
   "src": "abudraham",
   "anchor_w": [
    27,
    30
   ],
   "lemma": "מה רבו מעשיך ה',",
   "text": "מה רבו מעשיך ה', פסוק הוא.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    37,
    40
   ],
   "lemma": "המלך המרומם לבדו מאז",
   "text": "המלך המרומם לבדו מאז על שם אתה הוא ה' לבדך.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    41,
    46
   ],
   "lemma": "המשובח והמפואר והמתנשא כבר זכרנוה למעלה.",
   "text": "המשובח והמפואר והמתנשא כבר זכרנוה למעלה.",
   "quality": 0.75
  },
  {
   "src": "abudraham",
   "anchor_w": [
    44,
    45
   ],
   "lemma": "מימות עולם",
   "text": "מימות עולם על שם מעולם ועד עולם אתה אל.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    46,
    47
   ],
   "lemma": "אלקי עולם",
   "text": "אלקי עולם על שם אלקי עולם ה'.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    48,
    51
   ],
   "lemma": "ברחמיך הרבים רחם עלנו",
   "text": "ברחמיך הרבים רחם עלנו על שם וברחמיך הרבים לא עשיתם כלה.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    52,
    53
   ],
   "lemma": "אדון עזנו",
   "text": "אדון עזנו על שם ה' עזי ומעזי.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    54,
    55
   ],
   "lemma": "צור משגבנו",
   "text": "צור משגבנו על שם אלקי צורי אחסה בו מגני וקרן ישעי משגבי.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    56,
    57
   ],
   "lemma": "מגן ישענו",
   "text": "מגן ישענו על שם ותתן לי מגן ישעך.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    58,
    59
   ],
   "lemma": "משגב בעדנו",
   "text": "משגב בעדנו על שם ואתה ה' מגן בעדי. וכתב בעל המנהגות יש לתמוה למה נתקן בברכת המאורות אלקי עולם ברחמיך הרבים רחם עלנו.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    60,
    63
   ],
   "lemma": "אל ברוך גדול דעה",
   "text": "אל ברוך גדול דעה על שם ברוך ה' לעולם. ומה שתקנו לומר אלפא ביתא ביוצר של חול ושל שבת להודיע כי לא נתקיימו שמים וארץ.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    62,
    63
   ],
   "lemma": "גדול דעה",
   "text": "גדול דעה עם שם גדול העצה.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    64,
    67
   ],
   "lemma": "הכין ופעל זהרי חמה",
   "text": "הכין ופעל זהרי חמה על שם אתה הכינות מאור ושמש.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    65,
    65
   ],
   "lemma": "ופעל",
   "text": "ופעל על שם מי פעל ועשה.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    68,
    68
   ],
   "lemma": "טוב",
   "text": "טוב על שם וירא אלהים כי טוב ועל שם הודו לה' כי טוב.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    69,
    71
   ],
   "lemma": "יצר כבוד לשמו",
   "text": "יצר כבוד לשמו על שם כל הנקרא בשמי ולכבודי ברתיו.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
    72,
    75
   ],
   "lemma": "מאורות נתן סביבות עזו",
   "text": "מאורות נתן סביבות עזו על שם ונהורא עמיה שרי.",
   "quality": 1.0
  },
  {
   "src": "abudraham",
   "anchor_w": [
